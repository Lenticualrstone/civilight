<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 라이프 레코더 (LRC-06): asked only after the reason line, used only while recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 녹음 계속 (LRC-09): a recording goes on in the background as a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- U-13 · D32 (LRC-09): the ongoing recording notification is posted only with this on Android 13+;
         asked from the recording screen when a take first records (NotificationAsk). Refused, the take still records. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 받아쓰기 · 클라우드 (LRC-12): online is checked when a take starts; offline takes use the on-device engine. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- LRC-09: started only while a take records; it promotes itself (RecordingService). -->
        <service
            android:name="io.github.lenticualrstone.civilight.feature.recorder.outside.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- (0.2.0) LRC-48 · S-8: the quick-settings tile (RecorderTileService, LRC-03) and the home / cover-screen
             widget (RecorderWidgetProvider, LRC-02 / LRC-04) are not offered, so neither is declared; the system drops
             a tile or widget placed in 0.1.0 on upgrade. Their classes and resources stay for a later version. No
             show-when-locked activity is declared (LRC-05). -->
    </application>
</manifest>
