<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 (LRC-02, board LrEntry): mic in a `pri` circle and two lines. The text is set from Kotlin copy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recorder_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/recorder_widget_plate"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/recorder_widget_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/recorder_widget_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/recorder_widget_mic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recorder_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#ECECEF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recorder_widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#8E9099"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
